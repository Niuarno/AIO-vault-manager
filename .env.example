# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Found in your Supabase project dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Supabase Service Role Key (Keep secret! Used for server-side webhook ingestion)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ==============================================================================
# Internal Integration Security
# ==============================================================================
# Shared secret to authenticate webhook forwarding from telemation to the dashboard
DASHBOARD_INTERNAL_SECRET=telemation_secret_passphrase_here

# App URL (default local dev port 3001)
NEXT_PUBLIC_APP_URL=http://localhost:3001
PORT=3001
